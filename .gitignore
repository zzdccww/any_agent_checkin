# Public repository: track only the files required for daily check-ins.
# Keep local tests, documentation, credentials, and tooling private by default.
*

!/.gitattributes
!/.gitignore
!/README.md

!/.github/
!/.github/workflows/
!/.github/workflows/daily-checkin.yml

!/AnyRouter/
!/AnyRouter/app.py

!/agentrouter/
!/agentrouter/login.mjs
!/agentrouter/package.json
!/agentrouter/package-lock.json

!/scripts/
!/scripts/checkin_report.py
!/scripts/proxy_handler.py
